            "writeMultiplier": 1,
            "readMultiplier": 0.25,
            "isDefault": true,
            "confidence": "reported",
            "note": "Reported as 5 to 10 minutes of inactivity, extending to about an hour off peak. The lower bound is used so TTL findings understate rather than overstate."
          }
        ]
