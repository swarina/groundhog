          "source": "https://developers.openai.com/api/docs/guides/prompt-caching"
        },
        "cacheGranularityTokens": {
          "value": 128,
          "confidence": "documented",
          "note": "Cached spans land on 1024, 1152, 1280 and so on. A shared prefix between two of these steps is billed at the lower step.",
          "source": "https://developers.openai.com/api/docs/guides/prompt-caching"
        },
        "lookbackBlocks": {
          "value": null,
          "confidence": "unknown"
        },
        "routingKeyField": {
          "value": "prompt_cache_key",
          "confidence": "documented",
          "note": "Cache hits require requests to reach the same backend. Without this field, hit rate degrades as traffic spreads across machines, with no change to the prompt.",
          "source": "https://developers.openai.com/api/docs/guides/prompt-caching"
        },
        "scopeDimensions": {
          "value": [
            "model",
            "organisation",
            "tools",
            "response_format"
          ],
          "confidence": "inferred"
        },
        "ttls": [
